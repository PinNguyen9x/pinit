  "cards": [
    {
      "dot": "rose",
      "title": "Bốn lằn ranh không được vượt",
      "items": [
        "Agent commit local rồi dừng — push là việc của người",
        "agents sync không tự resolve conflict, nó dừng và báo",
        "Merge trên GitHub chọn merge commit, không Squash",
        "agents rm giữ lại branch, phải tự branch -d"
      ]
    },
    {
      "dot": "amber",
      "title": "Vì sao script làm vậy",
      "items": [
        "Gỡ upstream lúc tạo worktree: git push trần từng bắn vào main",
        "npm install lúc tạo: worktree mới không có node_modules, lint chết",
        "Trả .mcp.json về bản git trước rebase: cờ skip-worktree chặn rebase",
        "Branch đã push thì bỏ qua: rebase branch đã push là viết lại lịch sử"
      ]
    },
    {
      "dot": "cyan",
      "title": "Khi sync bỏ dở một worktree",
      "items": [
        "đã merge vào origin/main → dọn được, sang bước cuối",
        "đã push lên origin/<branch> → merge PR trước rồi sync lại",
        "conflict → vào worktree chạy rebase --continue hoặc --abort",
        "Trong lúc chờ, .mcp.json cố ý ở bản git và chưa có cờ"
      ]
    }
