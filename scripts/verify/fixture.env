# CHỈ CHỨA GIÁ TRỊ TEST. CẤM ĐẶT SECRET THẬT VÀO FILE NÀY.
#
# File được commit vào git có chủ đích: `npm run verify` phải cho cùng kết quả
# trên mọi máy và trong CI, nên cấu hình của nó phải nằm trong repo. Repo này
# public — mọi dòng dưới đây coi như ai cũng đọc được.
#
# Hai giá trị trông như bí mật nhưng không phải: passphrase là
# `pinit-verify-fixture`, ghi công khai ngay dưới đây, và nó chỉ mở được khu /me
# của một app chạy trên localhost với content giả. Không giá trị nào ở đây dùng
# được ở chỗ khác.
#
# Next.js không tự nạp file này. `scripts/verify/index.mjs` đọc nó tường minh
# rồi truyền vào env của tiến trình con — nạp env luôn là một bước thấy được.
#
# Chạy tay, không qua npm run verify:
#   set -a; . ./scripts/verify/fixture.env; set +a; npm run build && npm start

# --- Cửa vào khu /me ---------------------------------------------------------
# bcrypt cost 04 của passphrase `pinit-verify-fixture`. Cost thấp cố ý: verify
# đăng nhập nhiều lần, cost 12 chỉ làm chậm mà không thêm an toàn nào cho một
# hash đã công khai.
# Nháy đơn là bắt buộc: hash chứa `$`, và Docker Compose diễn giải `$` trong
# env_file nếu giá trị không bọc nháy đơn — hash bị cắt thì không passphrase nào
# khớp, mà triệu chứng chỉ là "login mãi không được".
OWNER_PASSWORD_HASH='$2b$04$x3be.dahL/sdA0DKzB7r5.9pA3E0WZprJmPaSosFDtO1mCKnWzXpu'

# Phải >= 32 ký tự. Ngắn hơn thì `getOwnerConfig()` coi như chưa cấu hình và mọi
# route /me trả 404 — kể cả /me/login.
SESSION_SECRET='pinit-verify-fixture-session-secret-khong-dung-that'

# --- Content giả -------------------------------------------------------------
# Dùng lại fixture đã có trong repo, cũng là fixture của
# utils/private-content.test.ts. Không tạo thư mục fixture thứ hai: hai bản cho
# cùng một schema sẽ lệch, và lúc lệch thì không biết bản nào đúng.
PRIVATE_CONTENT_DIR=private-content.example

# Log của /me/practice mặc định ghi vào PRIVATE_CONTENT_DIR — đẩy ra ngoài để
# fixture không bẩn sau mỗi lần chạy. `.verify-out/` nằm trong .gitignore.
PRACTICE_LOG_PATH=.verify-out/practice-log.jsonl

# --- Mock Anthropic ---------------------------------------------------------
# SDK `@anthropic-ai/sdk` đọc ANTHROPIC_BASE_URL, nên trỏ nó về stub cục bộ là
# chặn được mọi lời gọi ra ngoài mà không phải sửa một dòng code production.
# `scripts/verify/anthropic-mock.mjs` lắng nghe đúng cổng này.
#
# `index.mjs` TỪ CHỐI CHẠY nếu biến này không trỏ về loopback. Verify gọi
# /me/practice thật, nên một giá trị sai ở đây là tiền thật và dữ liệu thật.
ANTHROPIC_BASE_URL=http://127.0.0.1:4319

# Model không được gọi tới thật; tên chỉ đi vào payload mà stub bỏ qua. Ghim một
# giá trị cố định để response của stub lặp lại được giữa các lần chạy.
PRACTICE_MODEL=claude-haiku-4-5

# --- Các lớp cố ý TẮT --------------------------------------------------------
# Cloudflare Access: để rỗng CẢ HAI. Chỉ cần một biến có giá trị là lớp Access
# bật lên và mọi request /me trả 403 vì không có JWT.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Local không có nginx đứng trước nên không được tin X-Forwarded-For.
TRUST_PROXY=0

# --- Cố ý không đặt ở đây ----------------------------------------------------
# ANTHROPIC_API_KEY: `index.mjs` dựng giá trị giả lúc chạy. Không ghi ra đĩa một
#   chuỗi có dạng key thật — push protection của GitHub chặn đúng loại chuỗi đó,
#   và một key-shaped string trong repo public luôn là tín hiệu sai.
# API_URL: để mặc định (json-server-blog.vercel.app). Route phụ thuộc nó được
#   đánh dấu [ngoài] trong docs/feature-map.md và chỉ kiểm "không 5xx".
# NEXT_PUBLIC_SITE_URL: biến NEXT_PUBLIC_* được nhúng lúc BUILD, đặt ở đây
#   không có tác dụng với bundle đã build.
