# Mẫu cho /opt/learn-nextjs/.env.private trên VPS (prod).
#   cp .env.private.example .env.private && chmod 600 .env.private
# File thật KHÔNG commit. Staging để file RỖNG — khu /me tắt, tunnel không chạy.
# Mọi lần sửa file này phải `docker compose up -d --force-recreate`: env_file chỉ
# được đọc lúc TẠO container, `restart` giữ nguyên env cũ.

# --- Khu private /me (xem docs/private-area.md) ---------------------------
# Hash bcrypt PHẢI bọc nháy đơn: không nháy hoặc nháy kép thì Compose hiểu
# $2b$12$... là tên biến, hash tới container chỉ còn "$2b$12" -> login mãi không được.
# Sinh trên máy owner, không trên VPS (để passphrase không vào shell history server):
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" '<passphrase>'
OWNER_PASSWORD_HASH='$2b$12$................................................'

# openssl rand -hex 32  — ngắn hơn 32 ký tự thì /me tắt
SESSION_SECRET=

# Key từ Claude Console. Thiếu -> /me/practice tắt (503), roadmap/learn vẫn chạy.
ANTHROPIC_API_KEY=

# Tuỳ chọn, mặc định claude-haiku-4-5
# PRACTICE_MODEL=

# Tin X-Forwarded-For để rate limit đếm theo IP thật. Chỉ đúng khi vhost nginx có
# proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for VÀ (nếu đi qua
# Cloudflare) có snippet real_ip — xem docs/cloudflare.md, mục "real_ip".
# Qua Cloudflare mà thiếu real_ip thì phần tử cuối của XFF là IP của cloudflared
# (127.0.0.1): mọi khách chung một bucket, 5 lần sai của bất kỳ ai khoá tất cả.
TRUST_PROXY=1

# --- Cloudflare Tunnel (xem docs/cloudflare.md) ---------------------------
# Token của tunnel, lấy khi tạo tunnel trên dashboard Zero Trust.
# Tên biến là TUNNEL_TOKEN vì cloudflared đọc đúng tên này từ env.
# Chỉ có tác dụng khi $DIR/.env chứa COMPOSE_PROFILES=tunnel.
TUNNEL_TOKEN=

# --- Cloudflare Access cho /me (xem docs/cloudflare.md) -------------------
# Lớp kiểm JWT của Access, đứng TRƯỚC passphrase — không thay thế nó.
# Để RỖNG CẢ HAI thì bỏ qua check (local/staging không bị khoá).
# Đặt một biến mà bỏ biến kia -> app log cảnh báo [cf-access] và vẫn bỏ qua check.
#   CF_ACCESS_TEAM_DOMAIN: team domain, ví dụ pinit.cloudflareaccess.com
#                          (chỉ host, không https://, không dấu / cuối)
#   CF_ACCESS_AUD:         "Application Audience (AUD) Tag" trong Access app
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
